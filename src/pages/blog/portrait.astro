---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const sections = [
  {
    title: 'Comprendre la lumière',
    text: 'La lumière est l\'élément fondamental de toute photographie de portrait. La lumière naturelle, douce et diffuse, crée des rendus flatteurs avec des transitions subtiles entre ombres et hautes lumières. Expérimentez avec des réflecteurs et diffuseurs pour modeler la lumière selon vos envies. La "golden hour", juste après le lever ou avant le coucher du soleil, offre une lumière chaude et dorée particulièrement avantageuse pour les portraits.',
    image: '/assets/img/img-v0-min.jpg',
  },
  {
    title: 'Choisir le bon objectif',
    text: 'Pour le portrait, privilégiez les objectifs à grande ouverture (f/1.8, f/2.8) qui permettent un superbe flou d\'arrière-plan (bokeh), isolant naturellement votre sujet. Les focales entre 85mm et 135mm offrent une perspective flatteuse qui évite les déformations du visage. Un 50mm f/1.4 reste également un excellent choix polyvalent pour débuter en portrait.',
    image: '/assets/img/objectif-min.jpg',
  },
  {
    title: 'Communication avec le sujet',
    text: 'Un bon portrait repose sur la connexion entre le photographe et son sujet. Prenez le temps de mettre votre modèle à l\'aise, engagez la conversation et créez une atmosphère détendue. Guidez les poses avec douceur et donnez des indications claires. Les expressions les plus authentiques naissent souvent de moments spontanés entre les prises de vue dirigées.',
    image: '/assets/img/communication-min.jpg',
  },
  {
    title: 'Composition et cadrage',
    text: 'La règle des tiers reste un guide fiable : placez les yeux de votre sujet sur les points de force de l\'image. Expérimentez avec les lignes directrices, les cadres naturels (portes, fenêtres, arches) et l\'espace négatif. N\'hésitez pas à varier entre plans serrés sur le visage et plans plus larges intégrant l\'environnement.',
    image: '/assets/img/tiers-min.jpg',
  },
  {
    title: 'Post-production',
    text: 'Le développement est une étape clé du portrait. Ajustez l\'exposition, le contraste et la saturation pour donner du caractère à vos images. La retouche peau doit rester subtile et naturelle — lissez les imperfections temporaires tout en préservant la texture et le caractère du visage. Développez un style de retouche cohérent qui deviendra votre signature.',
    image: '/assets/img/experimentation-min.jpg',
  },
  {
    title: 'Expérimentation créative',
    text: 'Sortez des sentiers battus pour créer des portraits mémorables. Essayez des angles inhabituels, jouez avec les reflets, les ombres projetées ou les jeux de lumière colorée. Le mouvement, les doubles expositions et les techniques de flou créatif peuvent apporter une dimension artistique unique à votre travail.',
    image: '/assets/img/position-min.jpg',
  },
  {
    title: 'Utiliser les accessoires',
    text: 'Les accessoires ajoutent de la personnalité et du contexte à vos portraits. Chapeaux, écharpes, lunettes, bijoux ou objets personnels racontent une histoire et donnent au sujet quelque chose à faire de ses mains. Choisissez des accessoires qui complètent votre sujet sans le distraire, et qui s\'intègrent harmonieusement dans la palette de couleurs de l\'image.',
    image: '/assets/img/accessories-min.jpg',
  },
  {
    title: 'Maîtriser son équipement',
    text: 'Connaître parfaitement son matériel permet de se concentrer sur la créativité. Maîtrisez les relations entre ISO, vitesse d\'obturation et ouverture pour adapter votre exposition à chaque situation. Comprenez les modes autofocus de votre boîtier pour assurer une mise au point précise sur les yeux, même en mouvement et à grande ouverture.',
    image: '/assets/img/iso-min.jpg',
  },
];
---

<Layout
  title="Techniques de photographie de portrait | Blog Esteban Luiz"
  description="Découvrez les meilleures techniques pour capturer des portraits authentiques et expressifs. Conseils sur la lumière, la composition et la retouche."
  type="article"
  image="/assets/img/img-1-min.jpg"
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative h-[60vh] md:h-[70vh] flex items-end overflow-hidden">
      <img src="/assets/img/img-1-min.jpg" alt="Portrait photographique" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark via-dark/50 to-transparent"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-6 pb-16">
        <span class="text-accent text-xs uppercase tracking-[0.2em]">Portrait</span>
        <h1 class="font-heading text-3xl md:text-5xl text-white font-medium mt-3 leading-tight" style="font-family: var(--font-heading);">
          Les meilleures techniques pour la photographie de portrait
        </h1>
        <div class="flex items-center gap-4 mt-6 text-white/60 text-sm">
          <img src="/assets/img/esteban-min.jpg" alt="Esteban Luiz" class="w-8 h-8 rounded-full object-cover" />
          <span>Esteban Luiz</span>
          <span>&bull;</span>
          <span>15 Janvier 2025</span>
        </div>
      </div>
    </section>

    <!-- Content -->
    <article class="max-w-4xl mx-auto px-6 py-16 md:py-24">
      <p class="text-theme-muted text-lg leading-relaxed mb-16 reveal">
        La photographie de portrait est un art qui demande technique, sensibilité et connexion humaine. Voici les techniques essentielles pour capturer des portraits qui marquent les esprits.
      </p>

      {sections.map((section, i) => (
        <section class="mb-16 reveal">
          <div class:list={['grid md:grid-cols-2 gap-8 items-center', i % 2 === 1 && 'md:[direction:rtl] md:[&>*]:[direction:ltr]']}>
            <div>
              <h2 class="font-heading text-2xl text-theme font-medium mb-4" style="font-family: var(--font-heading);">
                {i + 1}. {section.title}
              </h2>
              <p class="text-theme-muted leading-relaxed">{section.text}</p>
            </div>
            <div class="aspect-[4/3] overflow-hidden">
              <img src={section.image} alt={section.title} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
          </div>
        </section>
      ))}

      <!-- Back link -->
      <div class="pt-8 border-t border-theme">
        <a href="/#blog" class="inline-flex items-center gap-2 text-accent text-sm hover:gap-3 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Retour au blog
        </a>
      </div>
    </article>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "Les meilleures techniques pour la photographie de portrait",
    "description": "Découvrez les meilleures techniques pour capturer des portraits authentiques et expressifs.",
    "image": "https://estebanluiz.fr/assets/img/img-1-min.jpg",
    "author": { "@type": "Person", "name": "Esteban Luiz" },
    "publisher": { "@type": "Organization", "name": "Esteban Luiz Photographie" },
    "datePublished": "2025-01-15",
    "dateModified": "2025-01-15"
  })} />
</Layout>
