---
const stats = [
  { value: '5+', label: 'Années d\'expérience' },
  { value: '500+', label: 'Projets réalisés' },
  { value: '200+', label: 'Clients satisfaits' },
];
---

<section id="about" class="py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Image -->
      <div class="reveal-left">
        <div class="relative">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/assets/img/esteban-min.jpg"
              alt="Esteban Luiz, photographe professionnel"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <!-- Decorative accent -->
          <div class="absolute -bottom-4 -right-4 w-32 h-32 border border-accent/30 -z-10"></div>
          <div class="absolute -top-4 -left-4 w-32 h-32 border border-accent/30 -z-10"></div>
        </div>
      </div>

      <!-- Content -->
      <div class="reveal-right">
        <p class="text-accent text-sm uppercase tracking-[0.2em] mb-4">À propos</p>
        <h2 class="font-heading text-4xl md:text-5xl text-theme font-medium mb-8" style="font-family: var(--font-heading);">
          Esteban Luiz
        </h2>
        <div class="space-y-4 text-theme-muted leading-relaxed">
          <p>
            Photographe passionné basé à Bordeaux, je capture des moments authentiques et des paysages époustouflants depuis plus de 5 ans. Mon objectif est de raconter des histoires à travers mes images.
          </p>
          <p>
            Spécialisé en portrait, paysage, architecture et événements, je m'engage à fournir des photographies de haute qualité qui reflètent la beauté et l'émotion de chaque instant. Chaque séance est une nouvelle aventure créative.
          </p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 mt-10 pt-10 border-t border-theme">
          {stats.map(stat => (
            <div>
              <p class="text-3xl md:text-4xl font-heading text-accent font-semibold" style="font-family: var(--font-heading);">{stat.value}</p>
              <p class="text-theme-muted text-xs uppercase tracking-wider mt-1">{stat.label}</p>
            </div>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#contact" class="px-8 py-3.5 bg-accent text-white text-sm font-medium tracking-wider uppercase hover:bg-accent-dark transition-colors duration-300">
            Réservez une séance
          </a>
          <a href="https://estebanluizantonio.myportfolio.com/work" target="_blank" rel="noopener noreferrer"
            class="px-8 py-3.5 border border-theme text-theme text-sm font-medium tracking-wider uppercase hover:border-accent hover:text-accent transition-colors duration-300">
            Portfolio complet
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
