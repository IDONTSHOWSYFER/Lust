---

---

<section id="home" class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img
      src="/assets/img/img-v0-min.jpg"
      alt="Photographie de paysage par Esteban Luiz"
      class="w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-dark via-transparent to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-4xl">
    <p class="text-accent text-sm uppercase tracking-[0.3em] mb-6 animate-fade-up" style="animation-delay: 0.2s; opacity: 0;">
      Photographe Professionnel &mdash; Bordeaux
    </p>
    <h1 class="font-heading text-5xl md:text-7xl lg:text-8xl text-white font-medium leading-[1.1] mb-8 animate-fade-up" style="font-family: var(--font-heading); animation-delay: 0.4s; opacity: 0;">
      Capturer l'essence<br />
      <em class="font-light">de chaque instant</em>
    </h1>
    <p class="text-white/70 text-lg md:text-xl font-light max-w-2xl mx-auto mb-10 animate-fade-up" style="animation-delay: 0.6s; opacity: 0;">
      Portrait, paysage, architecture et événements &mdash; des images qui racontent votre histoire.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-up" style="animation-delay: 0.8s; opacity: 0;">
      <a href="#portfolio" class="px-8 py-3.5 bg-accent text-white text-sm font-medium tracking-wider uppercase hover:bg-accent-dark transition-colors duration-300">
        Découvrir
      </a>
      <a href="#contact" class="px-8 py-3.5 border border-white/30 text-white text-sm font-medium tracking-wider uppercase hover:bg-white/10 transition-colors duration-300">
        Me contacter
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-fade-up" style="animation-delay: 1.2s; opacity: 0;">
    <div class="w-px h-16 bg-gradient-to-b from-white/50 to-transparent mx-auto mb-2"></div>
    <p class="text-white/40 text-xs uppercase tracking-widest">Scroll</p>
  </div>
</section>
