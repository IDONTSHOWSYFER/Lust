---
const images = [
  '/assets/img/img-7-min.jpg',
  '/assets/img/img-8-min.jpg',
  '/assets/img/img-9-min.jpg',
  '/assets/img/img-3-min.jpg',
  '/assets/img/img-0-min.jpg',
  '/assets/img/img-6-min.jpg',
  '/assets/img/img-13-min.jpg',
  '/assets/img/img-c0-min.jpg',
];
---

<section class="py-24 md:py-32 bg-theme-card overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <p class="text-accent text-sm uppercase tracking-[0.2em] mb-4">Instagram</p>
      <h2 class="font-heading text-4xl md:text-5xl text-theme font-medium mb-4" style="font-family: var(--font-heading);">
        @estebanluizantonio
      </h2>
      <p class="text-theme-muted text-sm">Suivez mon travail au quotidien</p>
    </div>
  </div>

  <!-- Full-width image strip -->
  <div class="grid grid-cols-4 md:grid-cols-8 stagger-children">
    {images.map((img, i) => (
      <a
        href="https://instagram.com/estebanluizantonio"
        target="_blank"
        rel="noopener noreferrer"
        class="aspect-square overflow-hidden relative group"
      >
        <img
          src={img}
          alt={`Instagram photo ${i + 1}`}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/20 transition-colors duration-300 flex items-center justify-center">
          <svg class="w-6 h-6 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300" fill="currentColor" viewBox="0 0 24 24">
            <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 01-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 017.8 2m-.2 2A3.6 3.6 0 004 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 003.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 110 2.5 1.25 1.25 0 010-2.5M12 7a5 5 0 110 10 5 5 0 010-10m0 2a3 3 0 100 6 3 3 0 000-6z" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
