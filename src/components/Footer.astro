---

<footer class="border-t border-theme py-16">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-3 gap-12 mb-12">
      <!-- Brand -->
      <div>
        <h3 class="font-heading text-2xl font-semibold text-theme mb-4" style="font-family: var(--font-heading);">Esteban Luiz</h3>
        <p class="text-theme-muted text-sm leading-relaxed max-w-xs">
          Photographe professionnel basé à Bordeaux. Capturer l'émotion et la beauté de chaque instant.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-medium text-theme uppercase tracking-wider mb-4">Navigation</h4>
        <ul class="space-y-2">
          <li><a href="/#portfolio" class="text-sm text-theme-muted hover:text-accent transition-colors">Portfolio</a></li>
          <li><a href="/#services" class="text-sm text-theme-muted hover:text-accent transition-colors">Services</a></li>
          <li><a href="/#about" class="text-sm text-theme-muted hover:text-accent transition-colors">À propos</a></li>
          <li><a href="/#contact" class="text-sm text-theme-muted hover:text-accent transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="text-sm font-medium text-theme uppercase tracking-wider mb-4">Réseaux</h4>
        <div class="flex gap-4">
          {socials.map(s => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
              class="w-10 h-10 rounded-full border border-theme flex items-center justify-center text-theme-muted hover:text-accent hover:border-accent transition-all duration-300">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.icon} /></svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="border-t border-theme pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-theme-subtle">&copy; {new Date().getFullYear()} Esteban Luiz. Tous droits réservés.</p>
      <a href="mailto:estebanluizantonio@gmail.com" class="text-xs text-theme-muted hover:text-accent transition-colors">
        estebanluizantonio@gmail.com
      </a>
    </div>
  </div>
</footer>

<!-- Scroll to top -->
<button id="scroll-top" class="fixed bottom-6 right-6 w-10 h-10 rounded-full bg-accent text-white flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:bg-accent-dark z-50" aria-label="Retour en haut">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  const scrollBtn = document.getElementById('scroll-top')!;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 500) {
      scrollBtn.classList.remove('opacity-0', 'pointer-events-none');
      scrollBtn.classList.add('opacity-100');
    } else {
      scrollBtn.classList.add('opacity-0', 'pointer-events-none');
      scrollBtn.classList.remove('opacity-100');
    }
  }, { passive: true });
  scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
