---

---

<section id="contact" class="py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16">
      <!-- Left side -->
      <div class="reveal-left">
        <p class="text-accent text-sm uppercase tracking-[0.2em] mb-4">Contact</p>
        <h2 class="font-heading text-4xl md:text-5xl text-theme font-medium mb-8" style="font-family: var(--font-heading);">
          Travaillons<br />ensemble
        </h2>
        <p class="text-theme-muted leading-relaxed mb-10 max-w-md">
          Vous avez un projet en tête ? N'hésitez pas à me contacter pour discuter de vos besoins en photographie. Je serai ravi de donner vie à votre vision.
        </p>

        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full border border-theme flex items-center justify-center text-accent">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <p class="text-theme-subtle text-xs uppercase tracking-wider">Email</p>
              <a href="mailto:estebanluizantonio@gmail.com" class="text-theme text-sm hover:text-accent transition-colors">estebanluizantonio@gmail.com</a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full border border-theme flex items-center justify-center text-accent">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <p class="text-theme-subtle text-xs uppercase tracking-wider">Localisation</p>
              <p class="text-theme text-sm">Bordeaux, France</p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full border border-theme flex items-center justify-center text-accent">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 01-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 017.8 2m-.2 2A3.6 3.6 0 004 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 003.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 110 2.5 1.25 1.25 0 010-2.5M12 7a5 5 0 110 10 5 5 0 010-10m0 2a3 3 0 100 6 3 3 0 000-6z" />
              </svg>
            </div>
            <div>
              <p class="text-theme-subtle text-xs uppercase tracking-wider">Instagram</p>
              <a href="https://instagram.com/estebanluizantonio" target="_blank" rel="noopener noreferrer" class="text-theme text-sm hover:text-accent transition-colors">@estebanluizantonio</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="reveal-right">
        <form id="contact-form" class="space-y-6">
          <div>
            <label for="name" class="block text-theme-muted text-xs uppercase tracking-wider mb-2">Nom</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full bg-transparent border-b border-theme py-3 text-theme text-sm focus:border-accent focus:outline-none transition-colors placeholder:text-theme-subtle"
              placeholder="Votre nom"
            />
          </div>
          <div>
            <label for="email" class="block text-theme-muted text-xs uppercase tracking-wider mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-transparent border-b border-theme py-3 text-theme text-sm focus:border-accent focus:outline-none transition-colors placeholder:text-theme-subtle"
              placeholder="votre@email.com"
            />
          </div>
          <div>
            <label for="message" class="block text-theme-muted text-xs uppercase tracking-wider mb-2">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full bg-transparent border-b border-theme py-3 text-theme text-sm focus:border-accent focus:outline-none transition-colors resize-none placeholder:text-theme-subtle"
              placeholder="Décrivez votre projet..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full sm:w-auto px-10 py-3.5 bg-accent text-white text-sm font-medium tracking-wider uppercase hover:bg-accent-dark transition-colors duration-300"
          >
            Envoyer le message
          </button>
          <p id="form-status" class="text-sm hidden"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = 'Envoi en cours...';
    btn.disabled = true;

    try {
      // EmailJS
      const { default: emailjs } = await import('https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js');
      emailjs.init('cgjiLXg6Si4G14GEb');

      await emailjs.send('service_v60hg29', 'template_ekdr0iw', {
        from_name: (form.querySelector('#name') as HTMLInputElement).value,
        from_email: (form.querySelector('#email') as HTMLInputElement).value,
        message: (form.querySelector('#message') as HTMLTextAreaElement).value,
      });

      status.textContent = 'Message envoyé avec succès !';
      status.className = 'text-sm text-green-500';
      status.classList.remove('hidden');
      form.reset();
    } catch {
      status.textContent = 'Erreur lors de l\'envoi. Veuillez réessayer.';
      status.className = 'text-sm text-red-500';
      status.classList.remove('hidden');
    } finally {
      btn.textContent = 'Envoyer le message';
      btn.disabled = false;
    }
  });
</script>
