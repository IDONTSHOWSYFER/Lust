---
const testimonials = [
  {
    name: 'Marie & Pierre',
    role: 'Mariage',
    text: 'Esteban a capturé notre journée spéciale avec une telle grâce et professionnalisme. Les photos sont tout simplement magnifiques, chaque image raconte un moment unique.',
    image: '/assets/img/testimonial1.jpg',
  },
  {
    name: 'Jean Dupont',
    role: 'Portrait professionnel',
    text: 'Un talent exceptionnel pour la photographie. Chaque image raconte une histoire. Je recommande vivement Esteban pour son œil artistique et sa capacité à mettre à l\'aise.',
    image: '/assets/img/testimonial2.jpg',
  },
  {
    name: 'Sophie Martin',
    role: 'Architecture intérieure',
    text: 'Les photos d\'architecture d\'Esteban sont incroyablement détaillées et artistiques. Il sait capturer l\'essence d\'un espace comme personne d\'autre.',
    image: '/assets/img/testimonial3.jpg',
  },
];
---

<section class="py-24 md:py-32 bg-theme-card">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16 reveal">
      <p class="text-accent text-sm uppercase tracking-[0.2em] mb-4">Témoignages</p>
      <h2 class="font-heading text-4xl md:text-5xl text-theme font-medium" style="font-family: var(--font-heading);">
        Ce qu'ils disent
      </h2>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid md:grid-cols-3 gap-8 stagger-children">
      {testimonials.map(t => (
        <div class="card-dark rounded-sm p-8 relative">
          <!-- Quote mark -->
          <svg class="w-8 h-8 text-accent/20 mb-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z" />
          </svg>
          <p class="text-theme-muted text-sm leading-relaxed mb-8">{t.text}</p>
          <div class="flex items-center gap-3">
            <img src={t.image} alt={t.name} class="w-10 h-10 rounded-full object-cover" loading="lazy" decoding="async" />
            <div>
              <p class="text-theme text-sm font-medium">{t.name}</p>
              <p class="text-theme-subtle text-xs">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
