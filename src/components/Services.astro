---
const services = [
  {
    title: 'Portrait',
    description: 'Des portraits authentiques qui capturent votre personnalité et votre essence unique.',
    icon: 'M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z',
    link: 'https://estebanluizantonio.myportfolio.com/portrait',
    image: '/assets/img/img-1-min.jpg',
  },
  {
    title: 'Paysage',
    description: 'La beauté naturelle immortalisée dans des clichés époustouflants et immersifs.',
    icon: 'M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M2.25 18V6a2.25 2.25 0 012.25-2.25h15A2.25 2.25 0 0121.75 6v12A2.25 2.25 0 0119.5 20.25H4.5A2.25 2.25 0 012.25 18z',
    link: 'https://estebanluizantonio.myportfolio.com/voyage',
    image: '/assets/img/img-3-min.jpg',
  },
  {
    title: 'Architecture',
    description: 'Des images saisissantes de structures, jeux de lignes et perspectives urbaines.',
    icon: 'M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21',
    link: 'https://estebanluizantonio.myportfolio.com/architecture',
    image: '/assets/img/img-8-min.jpg',
  },
  {
    title: 'Événements',
    description: 'Capturez les moments précieux de vos événements, mariages et célébrations.',
    icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
    link: 'https://estebanluizantonio.myportfolio.com/mariage',
    image: '/assets/img/img-4-min.jpg',
  },
];
---

<section id="services" class="py-24 md:py-32 bg-theme-card">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16 reveal">
      <p class="text-accent text-sm uppercase tracking-[0.2em] mb-4">Services</p>
      <h2 class="font-heading text-4xl md:text-5xl text-theme font-medium" style="font-family: var(--font-heading);">
        Ce que je propose
      </h2>
    </div>

    <!-- Grid -->
    <div class="grid md:grid-cols-2 gap-6 stagger-children">
      {services.map(service => (
        <a
          href={service.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative overflow-hidden aspect-[16/10] flex items-end"
        >
          <img
            src={service.image}
            alt={`Photographie de ${service.title}`}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          <div class="relative z-10 p-6 md:p-8 w-full">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={service.icon} />
                </svg>
              </div>
              <h3 class="text-white text-xl font-medium" style="font-family: var(--font-heading);">{service.title}</h3>
            </div>
            <p class="text-white/70 text-sm leading-relaxed max-w-md">{service.description}</p>
            <div class="mt-4 flex items-center gap-2 text-accent text-sm opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500">
              Voir le portfolio
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
